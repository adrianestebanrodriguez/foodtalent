# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/foodtalent

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-a-random-string

# Frontend URL (for password reset links)
FRONTEND_URL=https://foodtalent-five.vercel.app

# SMTP (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@foodtalent.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key-here

# Google Custom Search
GOOGLE_CSE_API_KEY=your-google-cse-api-key-here
GOOGLE_CSE_ID=your-google-cse-id-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://foodtalent-five.vercel.app"]

# Storage
BACKEND_STORAGE_PATH=storage